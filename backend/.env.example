# Backend - Archivo de ejemplo de variables de entorno
# Copiar este archivo y renombrarlo a ".env"
# Ajustar los valores según el entorno (local, dev, prod)

# Configuración del servidor
PORT=3000                # Puerto en el que corre el servidor backend

# Configuración de la base de datos MySQL
DB_HOST=localhost        # Host de la base de datos (ej: 127.0.0.1 o una URL en la nube)
DB_PORT=3306             # Puerto de conexión a MySQL
DB_USER=root             # Usuario de la base de datos
DB_PASSWORD=             # Contraseña del usuario
DB_NAME=chamba_db        # Nombre de la base de datos

# Seguridad y autenticación
JWT_SECRET=              # Clave secreta para firmar tokens JWT (poner valor largo y aleatorio)
